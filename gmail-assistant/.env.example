# Кому разрешено отправлять команды (через запятую). ОБЯЗАТЕЛЬНО.
ALLOWED_SENDERS=you@gmail.com

# Интервал опроса Gmail, мс
POLL_INTERVAL_MS=60000

# Ярлык Gmail для обработанных писем и корневая папка в Google Drive
PROCESSED_LABEL=AI-Assistant/Processed
DRIVE_ROOT_FOLDER=AI Assistant

# Лимиты
MAX_ATTACHMENT_MB=20
MAX_REPLY_TEXT_CHARS=20000

# Резюме: claude (нужен ANTHROPIC_API_KEY) или local (без внешних API)
SUMMARY_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# Пути к файлам Google OAuth (по умолчанию — в папке проекта)
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json
